# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=true @defaultSensitive=true
# ----------

# @type=string(startsWith="AGE-SECRET-KEY")
SOPS_AGE_KEY="AGE-SECRET-KEY"

# @sensitive=false @type=string(startsWith="age")
SOPS_AGE_PUBLIC_KEY="age1unqet4s4z2m4gjvvq8gurkd36r08pxannyua8se7l62552jd3efqg82gn3"
# Read-only token nix uses to fetch the private org inputs (secrets,
# clanServices, ...). A fine-grained PAT with Contents: read-only on
# those repos, kept apart from the rotating github-<user> PAT so a
# rotation never locks you out of building. Put the value in .env (or
# resolve it from 1Password); devenv prefers it over GH_TOKEN.
# @required=false @type=string(startsWith="github_pat_")
NIX_GITHUB_TOKEN=
