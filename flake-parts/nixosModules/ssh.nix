_: {
  # ------ NixOS Modules ------ #
  # Per-user SSH keypair provisioning: one ed25519 identity per user,
  # generated by `clan vars generate` (script generator, no prompting),
  # shared across machines (share = true). There is no official clanService
  # for user client keys — the `users` service only consumes pubkeys
  # (authorizedKeys) and `sshd` manages HOST keys/CA certs — so this module
  # declares "user-ssh-<user>" for every home-manager user with
  # homeSpec.programs.ssh.clanKey.enabled:
  #   /run/secrets/vars/shared/user-ssh-<user>/id_ed25519{,.pub}
  # (private: owner = user, mode 0400; public: non-secret value file).
  #
  # Non-destructive: ~/.ssh/id_ed25519 is never touched. git picks the pub
  # half up as its default signing key (homeModules/git.nix) once the var
  # exists; per-host ssh IdentityFile stanzas were removed for now.
  #
  # The pub half is also appended to the user's own authorizedKeys on every
  # machine declaring the keypair — that's what authenticates
  # `ssh <clan-host>` between clan machines. Guarded by .exists, so machine
  # evals work before the first `clan vars generate`.
  #
  # NOTE: this scan mirrors the option paths in homeModules/ssh.nix by hand
  # (defensive `or` access to avoid fixpoint recursion). If you rename or
  # restructure those options, update BOTH places — a stale scan silently
  # stops declaring the generator.
  flake.nixosModules.ssh = {
    config,
    lib,
    pkgs,
    ...
  }: let
    # Read-only scan of home-manager.users: users opting into the
    # clan-managed keypair. The sharedModules write below targets
    # clanKey.{privateKeyFile,publicKeyFile}, which this scan never
    # reads, so no fixpoint recursion is possible.
    keyUsers =
      lib.filterAttrs (
        _: hmUser: let
          ssh = ((hmUser.homeSpec or {}).programs or {}).ssh or {};
        in
          (ssh.enable or false) && ((ssh.clanKey or {}).enabled or false)
      )
      config.home-manager.users;
  in {
    config = {
      clan.core.vars.generators = lib.mkMerge (
        lib.mapAttrsToList
        (
          userName: _: {
            "user-ssh-${userName}" = {
              share = true;
              files = {
                id_ed25519 = {
                  owner = userName;
                  mode = "0400";
                  neededFor = "services";
                };
                "id_ed25519.pub".secret = false;
              };
              runtimeInputs = [pkgs.openssh];
              script = ''
                ssh-keygen -t ed25519 -f "$out/id_ed25519" -N "" -C "${userName}@clan"
              '';
            };
          }
        )
        keyUsers
      );

      # Authorize the generated pubkey for its owner on every machine that
      # declares the keypair (list merges with the static keys in
      # users/<user>/default.nix).
      users.users = lib.mkMerge (
        lib.mapAttrsToList
        (
          userName: _: let
            pubFile = config.clan.core.vars.generators."user-ssh-${userName}".files."id_ed25519.pub";
          in {
            openssh.authorizedKeys.keys = lib.optional pubFile.exists pubFile.value;
          }
        )
        keyUsers
      );

      # Feed the deployed paths into the home module — profiles never
      # hardcode /run/secrets paths. Goes through sharedModules (a static
      # module list): writing scan-derived keys into home-manager.users
      # instead would recurse on the option this file's scan reads.
      home-manager.sharedModules = [
        (
          {
            config,
            lib,
            osConfig,
            ...
          }: let
            generator = "user-ssh-${config.home.username}";
            generators = osConfig.clan.core.vars.generators or {};
            hasGenerator = osConfig != null && generators ? ${generator};
            pubFile = generators.${generator}.files."id_ed25519.pub";
          in {
            homeSpec.programs.ssh.clanKey = lib.mkIf (osConfig != null) {
              # Secret path is eval-safe pre-generation (clan's sops
              # fileModule reports "/no-such-path").
              privateKeyFile = lib.mkIf hasGenerator generators.${generator}.files.id_ed25519.path;
              # Doubles as git's default signing key — nulled until the pub
              # var actually exists so commits stay unsigned rather than
              # pointing at a missing file.
              publicKeyFile = lib.mkIf (hasGenerator && pubFile.exists) pubFile.path;
            };
          }
        )
      ];
    };
  };
}
