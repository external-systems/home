{inputs, ...}: {
  # ------ Per-System ------ #
  # General-purpose coding sandbox image for OpenShell (VM driver): a
  # lean, hand-picked toolset + nix (runtime package adds via
  # substitution) + first-class VSCodium Remote-SSH support. This is the
  # single place OpenShell sandbox images come from — devenv stays
  # human-only.
  #
  # Built with nix2container, NOT dockerTools: the VM driver's image-prep
  # (umoci-v3) reproducibly corrupts the ext4 it produces from the
  # dockerTools stream of a large image ("Block bitmap checksum does not
  # match"), while nix2container images (same layer counts, same sizes)
  # provision fine. Tiny dockerTools images pass, so the trigger is
  # size/layer-count dependent; nix2container is the proven path on this
  # driver.
  #
  # Delivery to the VM driver (openshell-driver-vm): the driver first
  # checks the host container engine's local image store, so
  # `nix run .#load-code-agent-image` (skopeo copy into docker-daemon:)
  # is enough; OCI registry pull is the fallback.
  #
  # Remote-SSH contract (learned the hard way): there is NO OpenSSH sshd
  # in the sandbox — the OpenShell supervisor speaks ssh itself, spawns
  # every process with a SCRUBBED env (env_clear: only HOME/USER/PATH/
  # TERM/SHELL + injected TLS vars + provider creds; the image Env below
  # never reaches in-VM processes), runs interactive sessions as
  # `bash -i` (NON-login: reads ~/.bashrc ONLY) and remote commands /
  # editor bootstraps as `bash -lc` (login: /etc/profile). Client ssh
  # SetEnv/SendEnv requests are accepted and discarded, but the client's
  # TERM arrives verbatim via the pty request — so the image must carry
  # the terminfo entry for every terminal a user connects from (ghostty
  # included). The image answers all of it: /etc/profile + baked
  # ~/.bashrc/.bash_profile at BOTH $HOME roots (generated by a
  # standalone home-manager evaluation of the minimal profile-agent
  # module — dotfile generator only, no activation/systemd/runtime HM),
  # a full terminfo db at
  # the FHS locations (terminfoDb below), the /usr/local/bin toolchain
  # on top of /bin, and the create-time --env set
  # (packages.code-agent-env, passed by code-sandbox create) as the env
  # channel that survives even a workdir-masked HOME. The vscodium-reh
  # tarball's bundled node is a foreign glibc binary — it gets
  # patchelf'd to the image glibc (pre-baked server below), and the
  # nix-ld shim (/lib64/ld-linux-x86-64.so.2 + NIX_LD env, rootfs below)
  # covers any other downloaded glibc ELF.
  perSystem = {
    pkgs,
    inputs',
    self',
    customLib,
    ...
  }: let
    inherit (pkgs) lib;
    inherit (customLib) relativeToRoot;
    n2c = inputs'.nix2container.packages.nix2container;

    # VSCodium release whose vscodium-reh server matches the fleet's
    # codium 1.126.0 (DISTRO_COMMIT from `Help > About`). Bump both when
    # nixpkgs' vscodium moves; on mismatch the install script falls back
    # to downloading (github.com + *.githubusercontent.com must stay
    # admitted in openshell/policies/code-agent.yaml).
    vscodiumVersion = "1.126.04524";
    vscodiumCommit = "4c0b0c6cc561d2d3636d1ec250935431876ce4dc";

    # vscodium-reh server payload with the bundled node patchelf'd to
    # the image toolchain: nix store rpath/interpreter, so it runs with
    # no env, no ld.so.cache dependency, and no FHS assumptions.
    vscodium-server = pkgs.stdenv.mkDerivation {
      pname = "vscodium-reh";
      version = vscodiumVersion;
      src = pkgs.fetchurl {
        url = "https://github.com/VSCodium/vscodium/releases/download/${vscodiumVersion}/vscodium-reh-linux-x64-${vscodiumVersion}.tar.gz";
        hash = "sha256-NC+skexxc6/7jdALQ5uGiz7mziKdx9GLuUx83W2YWoA=";
      };
      nativeBuildInputs = [pkgs.patchelf];
      dontUnpack = true;
      dontStrip = true;
      installPhase = ''
        runHook preInstall
        mkdir -p $out
        tar -xzf $src -C $out --strip-components=1
        patchelf \
          --set-interpreter ${pkgs.glibc}/lib/ld-linux-x86-64.so.2 \
          --set-rpath ${lib.makeLibraryPath [pkgs.stdenv.cc.cc.lib pkgs.glibc]} \
          $out/node
        # The upstream tarball ships scripts with the CI's nix store
        # bash in the shebang — an accident of matching nixpkgs pins,
        # not a contract. Point them at the image bash.
        sed -i '1s|^#!.*|#!${pkgs.bashInteractive}/bin/sh|' $out/bin/codium-server
        runHook postInstall
      '';
    };

    # Full terminal database: ncurses' complete terminfo set plus
    # ghostty's own entries. ncurses 6.6 ships g/ghostty but NOT
    # xterm-ghostty — which is exactly the TERM a ghostty client sends
    # (raw ssh passes the client's TERM through the pty request; the
    # supervisor's ssh server does not rewrite it). ghostty's official
    # entries win over ncurses' derivations of them.
    terminfoDb = pkgs.runCommand "code-agent-terminfo" {} ''
      mkdir -p $out/share
      cp -r ${pkgs.ncurses}/share/terminfo $out/share/terminfo
      chmod -R u+w $out/share/terminfo
      cp -fL ${pkgs.ghostty.terminfo}/share/terminfo/x/xterm-ghostty \
        $out/share/terminfo/x/xterm-ghostty
      cp -fL ${pkgs.ghostty.terminfo}/share/terminfo/g/ghostty \
        $out/share/terminfo/g/ghostty
    '';

    # Agent shell dotfiles AND the pi/kimi/claude user configs, all
    # generated by a STANDALONE home-manager evaluation and baked at BOTH
    # $HOME roots (/home/agent and /sandbox — the supervisor points
    # HOME at /sandbox). Home-manager is used strictly as a
    # file/package generator at image-build time: no activation, no
    # systemd, no runtime `home-manager switch` in the sandbox.
    # ~/.bashrc is LOAD-BEARING here: the supervisor's ssh server
    # spawns interactive sessions as `bash -i` — a non-login shell that
    # reads ~/.bashrc and nothing else — and the profile's initExtra
    # sources the idempotent /etc/profile from it (see the module for
    # why). home-path (the profile's user package set — starship/uv;
    # NOT the agent CLIs, installPackage=false — the image's launcher
    # wrappers are the only bins) is merged into baseTools below.
    #
    # Modules: profile-agent (dotfiles/toolchain) + agents + headroom
    # (the shared homeSpec namespaces — the headroom module is imported
    # for its OPTIONS only; its systemd service stays off) +
    # hmAgentSandboxModule (the image's mandatory agent defaults: the
    # MCP trio, provider wiring, headroom-proxy routing — baked into
    # the agents' config FILES, the only channel that survives the
    # supervisor's process-env scrub).
    hmAgent = inputs.home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      # homeModules.agents wants customLib (relativeToRoot); osConfig
      # arrives as null in a standalone eval (machineContext writes
      # never fire, hostName="").
      extraSpecialArgs = {inherit customLib;};
      modules = [
        inputs.self.homeModules.profile-agent
        inputs.self.homeModules.agents
        inputs.self.homeModules.headroom
        hmAgentSandboxModule
      ];
    };
    hmAgentHomePath = hmAgent.activationPackage + "/home-path";

    # Repo skill set baked read-only at /opt/skills, built by
    # inputs.agents.lib.mkSkills — the same helper (and the same repo
    # skills/ + external-sources composition) home-manager installs for
    # the agents on NixOS hosts (homeSpec.agents.skills in
    # flake-parts/homeModules/agents.nix). Wired into pi/kimi/claude in
    # agentDirs above.
    skillsTree = inputs.agents.lib.mkSkills {
      inherit pkgs;
      customSkills = relativeToRoot "skills";
      # Mirror of the fleet-wide list in
      # flake-parts/homeModules/agents.nix (externalSkillSources) —
      # the same tree the NixOS hosts install for their agents.
      # homeSpec.agents.skills.extraSources remains the per-machine
      # escape hatch on the home-manager side (not baked here).
      externalSkills = [
        {
          src = inputs.skills-anthropic;
          selectSkills = ["doc-coauthoring" "docx" "internal-comms" "mcp-builder" "skill-creator" "xlsx"];
        }
        {src = inputs.skills-cloudflare;}
        {src = inputs.skills-payloadcms;}
        {src = inputs.skills-supabase;}
        {src = inputs.skills-fluxcd;}
        {src = inputs.skills-terraform;}
        # Google official skills — all categories (nested
        # skills/<category>/<name> layout, one entry per category).
        {
          src = inputs.skills-google;
          skillsDir = "skills/ads";
        }
        {
          src = inputs.skills-google;
          skillsDir = "skills/analytics";
        }
        {
          src = inputs.skills-google;
          skillsDir = "skills/cloud";
        }
        {
          src = inputs.skills-google;
          skillsDir = "skills/developers";
        }
        {
          src = inputs.skills-google;
          skillsDir = "skills/identity";
        }
        {src = inputs.openshell;}
        {
          src = inputs.openshell;
          skillsDir = ".agents/skills";
        }
      ];
    };

    # /etc/ssl/certs/ca-certificates.crt → the gateway's supervisor CA
    # bundle (the OpenShell gateway MITMs TLS with a per-gateway CA
    # mounted at /run/openshell-supervisor-ca/material/; nix BUILDERS
    # run with a scrubbed env, so env-less TLS clients inside FODs —
    # go mod vendor in buildGoModule go-modules FODs — failed with
    # "x509: certificate signed by unknown authority", verified
    # 2026-10). ca-certificates.crt is go's FIRST default cert-file
    # probe (also why go works on NixOS, which ships that name).
    # Under plain docker the symlink dangles — go/openssl skip
    # unreadable candidates and fall back to cacert's public bundle in
    # the same dir, so both modes work.
    #
    # Lives in baseTools, NOT rootfs: cacert is /etc/ssl's only other
    # provider, so buildEnv links /etc/ssl as a whole-dir SYMLINK, and a
    # rootfs-side real /etc/ssl dir conflicts with it at image assembly
    # ("the file '/etc/ssl' already exists in the graph with mode
    # 'Lrwxrwxrwx' ... added again with mode 'dr-xr-xr-x'" — layers.json
    # build failure, observed 2026-10). As a second buildEnv provider,
    # /etc/ssl becomes a merged real dir instead.
    supervisorCaLink = pkgs.runCommand "supervisor-ca-link" {} ''
      mkdir -p $out/etc/ssl/certs
      ln -s /run/openshell-supervisor-ca/material/ca-bundle.crt \
        $out/etc/ssl/certs/ca-certificates.crt
    '';

    # /bin + /usr/bin toolset (the sshd default PATH covers /bin) plus
    # merged /etc contributions (ssl certs, ssh client config, nix
    # profile snippets, /usr/bin/env).
    baseTools = pkgs.buildEnv {
      name = "code-agent-base";
      paths = with pkgs; [
        # The HM profile's user package set (starship, uv — the
        # profile's bashrc initializes starship from the store path
        # anyway; home-path puts both CLIs on PATH in every shell).
        hmAgentHomePath
        bashInteractive
        coreutils
        gnused
        gnugrep
        gawk
        findutils
        gnutar
        gzip
        xz
        procps
        util-linux
        git
        gh
        curl
        cacert
        supervisorCaLink
        jq
        yq
        python3
        ripgrep
        openssh
        tmux
        less
        nix
        # Nix language server + the repo's lint trio: agent-edited
        # .nix files can be vetted in-sandbox (runtime `nix profile
        # install` adds work too, but TCG builds crawl — bake them).
        nixd
        alejandra
        statix
        deadnix
        # General build/debug tooling: archives (unzip/zstd), scripted
        # downloads (wget — many install scripts hardcode it), foreign
        # ELF inspection (file/readelf/objdump/ldd — the patchelf/FHS
        # fallback path), hand-applied patches (diff/patch), k8s clients
        # (kubectl/helm — cluster API egress rides an attached provider
        # or port-forward, so no policy host is bound here), agent
        # ergonomics (fd/sd), shell vetting (shellcheck/shfmt), and DNS
        # digs for policy debugging (dnsutils). No rsync here or in the
        # HM profile — its receiver is denied in-sandbox (see
        # profile-agent-base).
        unzip
        zstd
        wget
        file
        binutils
        diffutils
        patch
        kubectl
        kubernetes-helm
        fd
        sd
        shellcheck
        shfmt
        dnsutils
        # Go toolchain: module/toolchain fetches ride the golang policy
        # entry (proxy.golang.org + sum.golang.org admitted for the go
        # binary; direct-VCS fallback reuses git's github/gitea
        # admissions). GOPATH/GOMODCACHE default to writable $HOME/go.
        go
        # Tiny but constantly missed: which (install scripts probe with
        # it) and ncurses' clear/tput/reset (nixpkgs ncurses carries its
        # own terminfo db — verified clear works under a real TERM).
        which
        ncurses
        # The clan CLI: baked because it can never be obtained
        # in-sandbox — clan-cli's clan-runtime dependency builds with a
        # nested `nix flake update --store ./.` inside the builder,
        # which the sandbox supervisor's egress and the overlayfs
        # rename assert cannot support (verified: exit 134 in-sandbox).
        # On the image-build host the derivation substitutes/builds
        # normally, and in-sandbox the finished closure runs fine.
        clan-cli
        # AI coding agents (all from the llm-agents flake input, see
        # overlays/default.nix): pi runs on bun, kimi-code and
        # claude-code are bundled node/bun apps — closures carry their
        # runtimes.
        pi-coding-agent
        kimi-code
        claude-code
        dockerTools.usrBinEnv
        # github-mcp-server: driven by the agents' baked mcp.json
        # (see sandboxMcpServers); auth rides the github-agent provider
        # attached at sandbox creation.
        pkgs.unstable.github-mcp-server
      ];
      pathsToLink = ["/bin" "/usr/bin" "/etc"];
    };

    # FHS rootfs additions merged at the image /:
    #  - /usr/local/bin: install-script + server-side toolchain, in case
    #    the sshd PATH lacks /bin in some invocation path.
    #  - /etc/{os-release,profile,passwd,group,shadow}: truthful
    #    os-release for the install script, PATH + foreign-ELF/wheel
    #    runtime env for login shells, and identity for nix (getpwuid
    #    home lookup) and the vscodium server's shells.
    #  - /lib64/ld-linux-x86-64.so.2: the nix-ld shim (with
    #    /usr/lib/wheel-deps) — foreign glibc ELFs resolve through the
    #    shim's NIX_LD/NIX_LD_LIBRARY_PATH env, not through copied libs
    #    or an ld.so.cache (nixpkgs glibc never reads /etc/ld.so.cache;
    #    its compiled-in cache path is the read-only store etc/).
    rootfs = pkgs.runCommand "code-agent-rootfs" {} ''
      mkdir -p $out/usr/local/bin $out/etc $out/usr/share \
        $out/lib $out/lib64 $out/usr/lib/wheel-deps

      # sshd-default-PATH toolchain.
      ln -s ${pkgs.bashInteractive}/bin/bash        $out/usr/local/bin/bash
      ln -s ${pkgs.coreutils}/bin/uname             $out/usr/local/bin/uname
      ln -s ${pkgs.gnused}/bin/sed                  $out/usr/local/bin/sed
      ln -s ${pkgs.gnugrep}/bin/grep                $out/usr/local/bin/grep
      ln -s ${pkgs.gnutar}/bin/tar                  $out/usr/local/bin/tar
      ln -s ${pkgs.gzip}/bin/gzip                   $out/usr/local/bin/gzip
      ln -s ${pkgs.gzip}/bin/gunzip                 $out/usr/local/bin/gunzip
      ln -s ${pkgs.curl}/bin/curl                   $out/usr/local/bin/curl
      ln -s ${pkgs.procps}/bin/ps                   $out/usr/local/bin/ps
      ln -s ${pkgs.util-linux}/bin/flock            $out/usr/local/bin/flock
      ln -s ${pkgs.git}/bin/git                     $out/usr/local/bin/git
      ln -s ${pkgs.gh}/bin/gh                       $out/usr/local/bin/gh
      ln -s ${pkgs.jq}/bin/jq                       $out/usr/local/bin/jq
      ln -s ${pkgs.yq}/bin/yq                       $out/usr/local/bin/yq
      ln -s ${pkgs.python3}/bin/python3             $out/usr/local/bin/python3
      ln -s ${pkgs.ripgrep}/bin/rg                  $out/usr/local/bin/rg
      ln -s ${pkgs.tmux}/bin/tmux                   $out/usr/local/bin/tmux
      ln -s ${pkgs.less}/bin/less                   $out/usr/local/bin/less
      ln -s ${pkgs.openssh}/bin/ssh                 $out/usr/local/bin/ssh
      ln -s ${pkgs.openssh}/bin/scp                 $out/usr/local/bin/scp
      ln -s ${pkgs.openssh}/bin/sftp                $out/usr/local/bin/sftp
      ln -s ${pkgs.nix}/bin/nix                     $out/usr/local/bin/nix
      # pi/kimi/claude resolve to the launcher wrappers (headroom proxy
      # ensure + exec the real CLI) — the ONLY bins for the agents
      # (homeSpec.agents.<agent>.installPackage=false keeps HM's
      # home-path free of duplicates).
      ln -s ${sandboxPi}/bin/pi                     $out/usr/local/bin/pi
      ln -s ${sandboxKimi}/bin/kimi                 $out/usr/local/bin/kimi
      ln -s ${sandboxClaude}/bin/claude             $out/usr/local/bin/claude
      ln -s ${pkgs.clan-cli}/bin/clan               $out/usr/local/bin/clan
      ln -s ${pkgs.nixd}/bin/nixd                   $out/usr/local/bin/nixd
      ln -s ${pkgs.alejandra}/bin/alejandra         $out/usr/local/bin/alejandra
      ln -s ${pkgs.statix}/bin/statix               $out/usr/local/bin/statix
      ln -s ${pkgs.deadnix}/bin/deadnix             $out/usr/local/bin/deadnix
      ln -s ${pkgs.unzip}/bin/unzip                 $out/usr/local/bin/unzip
      ln -s ${pkgs.zstd}/bin/zstd                   $out/usr/local/bin/zstd
      ln -s ${pkgs.wget}/bin/wget                   $out/usr/local/bin/wget
      ln -s ${pkgs.file}/bin/file                   $out/usr/local/bin/file
      ln -s ${pkgs.binutils}/bin/readelf            $out/usr/local/bin/readelf
      ln -s ${pkgs.binutils}/bin/objdump            $out/usr/local/bin/objdump
      ln -s ${pkgs.glibc.bin}/bin/ldd               $out/usr/local/bin/ldd
      ln -s ${pkgs.diffutils}/bin/diff              $out/usr/local/bin/diff
      ln -s ${pkgs.patch}/bin/patch                 $out/usr/local/bin/patch
      ln -s ${pkgs.kubectl}/bin/kubectl             $out/usr/local/bin/kubectl
      ln -s ${pkgs.kubernetes-helm}/bin/helm        $out/usr/local/bin/helm
      ln -s ${pkgs.fd}/bin/fd                       $out/usr/local/bin/fd
      ln -s ${pkgs.sd}/bin/sd                       $out/usr/local/bin/sd
      ln -s ${pkgs.shellcheck}/bin/shellcheck       $out/usr/local/bin/shellcheck
      ln -s ${pkgs.shfmt}/bin/shfmt                 $out/usr/local/bin/shfmt
      ln -s ${pkgs.dnsutils}/bin/dig                $out/usr/local/bin/dig
      # uv comes from the HM profile's home-path (programs.uv in
      # profile-agent) — same pkgs.uv store path, so this fixed FHS
      # symlink target is unchanged.
      ln -s ${hmAgentHomePath}/bin/uv                 $out/usr/local/bin/uv
      ln -s ${pkgs.go}/bin/go                       $out/usr/local/bin/go
      ln -s ${pkgs.go}/bin/gofmt                    $out/usr/local/bin/gofmt
      ln -s ${pkgs.bun}/bin/bun                     $out/usr/local/bin/bun
      ln -s ${pkgs.which}/bin/which                 $out/usr/local/bin/which
      ln -s ${pkgs.ncurses}/bin/clear               $out/usr/local/bin/clear
      ln -s ${pkgs.ncurses}/bin/infocmp             $out/usr/local/bin/infocmp
      ln -s ${pkgs.ncurses}/bin/tput                $out/usr/local/bin/tput
      # Terminfo db at the FHS search locations (terminfoDb above):
      # /usr/share/terminfo for TERMINFO_DIRS + modern ncurses
      # defaults, /etc/terminfo and /lib/terminfo for the Debian-style
      # fallback lists foreign binaries are often compiled with.
      ln -s ${terminfoDb}/share/terminfo            $out/usr/share/terminfo
      ln -s ${terminfoDb}/share/terminfo            $out/etc/terminfo
      ln -s ${terminfoDb}/share/terminfo            $out/lib/terminfo
      # headroom via the env-mapping wrapper (MCP configs and
      # interactive use both resolve to this PATH entry).
      ln -s ${sandboxHeadroom}/bin/headroom         $out/usr/local/bin/headroom

      # Login shells (interactive SSH + VSCodium terminal) read
      # /etc/profile: put the layer on PATH there too, plus the
      # foreign-ELF/wheel runtime env (sshd-spawned shells can run with
      # a scrubbed env, losing the image Env values). LD_LIBRARY_PATH
      # and NIX_LD_LIBRARY_PATH append rather than overwrite. (Quoted
      # heredoc: Nix interpolates the store paths at eval time; the
      # runtime $ expansions stay literal for the sourcing shell.)
      # Idempotent under repeat sourcing: nested `bash -l` shells
      # re-read this file, and the pre-fix version appended on every
      # pass — tripling PATH, LD_LIBRARY_PATH and NIX_LD_LIBRARY_PATH
      # in long agent sessions (observed live). PATH and
      # LD_LIBRARY_PATH get a membership test; NIX_LD and
      # NIX_LD_LIBRARY_PATH are set only when absent (they are image
      # Env values; a shell that scrubbed its env still gets them, but
      # an existing value is never re-appended to).
      cat > $out/etc/profile <<'EOF'
      # shellcheck shell=sh
      # Login shells default to a sane umask regardless of what the
      # spawning process (supervisor, sshd, vscodium server) inherited.
      umask 022
      case ":$PATH:" in
        *:/usr/local/bin:*) ;;
        *) export PATH="/usr/local/bin:$PATH" ;;
      esac
      # uv tool/pipx-style user binaries (uv warns otherwise; $HOME is
      # /sandbox under the supervisor, /home/agent under plain docker).
      case ":$PATH:" in
        *:"$HOME/.local/bin":*) ;;
        *) export PATH="$HOME/.local/bin:$PATH" ;;
      esac
      case ":$LD_LIBRARY_PATH:" in
        *:/usr/lib/wheel-deps:*) ;;
        *) export LD_LIBRARY_PATH="/usr/lib/wheel-deps''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
      esac
      if [ -z "''${NIX_LD:-}" ]; then
        export NIX_LD="${pkgs.glibc}/lib/ld-linux-x86-64.so.2"
      fi
      if [ -z "''${NIX_LD_LIBRARY_PATH:-}" ]; then
        export NIX_LD_LIBRARY_PATH="${nixLdLibs}"
      fi
      # Terminfo: the baked db (full ncurses + ghostty) at the FHS
      # location. ssh forwards the client's TERM via the pty request, so
      # exotic terminals (xterm-ghostty, ...) must resolve in-image.
      if [ -z "''${TERMINFO_DIRS:-}" ]; then
        export TERMINFO_DIRS="/usr/share/terminfo:${pkgs.ncurses}/share/terminfo"
      fi
      # XDG_RUNTIME_DIR: no systemd-logind in the microVM creates
      # /run/user/<uid>, so tools that consult the variable (podman-style
      # runtimes, CLI state sockets) would fall back to odd locations.
      # Point at a private /tmp dir instead. NOTE: claude-code's
      # cross-session messaging cannot use it — its sockets-dir walk
      # refuses '/' itself (owned by the VM host's overflow ids) — the
      # claude launcher wrapper passes --messaging-socket-path instead.
      if [ -z "''${XDG_RUNTIME_DIR:-}" ]; then
        _xdg_runtime="/tmp/xdg-runtime-$(id -u 2>/dev/null || echo 1000)"
        if mkdir -p "$_xdg_runtime" 2>/dev/null && chmod 700 "$_xdg_runtime" 2>/dev/null; then
          export XDG_RUNTIME_DIR="$_xdg_runtime"
        fi
        unset _xdg_runtime
      fi
      # FOD builders inherit NIX_SSL_CERT_FILE via impureEnvVars and
      # hang git/curl fetchers off it (buildGoModule sets
      # GIT_SSL_CAINFO=$NIX_SSL_CERT_FILE): point it at the supervisor
      # CA bundle when the gateway's MITM CA is mounted, else the
      # public bundle (plain docker). Go itself does not read this var
      # — the /etc/ssl/certs/ca-certificates.crt symlink (rootfs below)
      # is what covers env-less go inside builders.
      if [ -z "''${NIX_SSL_CERT_FILE:-}" ]; then
        if [ -r /run/openshell-supervisor-ca/material/ca-bundle.crt ]; then
          export NIX_SSL_CERT_FILE=/run/openshell-supervisor-ca/material/ca-bundle.crt
        else
          export NIX_SSL_CERT_FILE="${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt"
        fi
      fi
      EOF

      # nix config on disk (see nixConfig above): unlike $NIX_CONFIG in
      # the image Env, every nix invocation reads this — VSCodium-server
      # and sshd-spawned shells can run with a store-only or scrubbed
      # env, which is exactly how `nix run` ended up with flakes
      # disabled.
      mkdir -p $out/etc/nix
      cat > $out/etc/nix/nix.conf <<'EOF'
      ${nixConfig}
      EOF

      # Pin the flake registry so `nix run nixpkgs#…` resolves without
      # channels.nixos.org (not admitted; nix reports "you don't have
      # Internet access" otherwise). A baked-in nixpkgs checkout was
      # dropped on purpose: it is the image's single heaviest payload
      # (hundreds of MB unpacked for a tree an agent touches rarely),
      # and nix2container's copyToRoot rewrite semantics dump the tree
      # at the image root instead of its store path. Pinning the alias
      # to the nixos-unstable branch on github.com (admitted) costs one
      # ~50MB tarball fetch on first resolution, cached in
      # ~/.cache/nix afterwards; binaries still come from the admitted
      # cache.nixos.org substituter.
      cat > $out/etc/nix/registry.json <<'EOF'
      {
        "flakes": [
          {
            "from": {"id": "nixpkgs", "type": "indirect"},
            "to": {"owner": "NixOS", "repo": "nixpkgs", "ref": "nixos-unstable", "type": "github"}
          }
        ],
        "version": 2
      }
      EOF

      printf '%s\n' 'NAME="code-agent"' 'ID="code-agent"' > $out/etc/os-release

      # Name-resolution contracts, baked explicitly instead of left to
      # per-resolver built-in defaults: without /etc/nsswitch.conf,
      # glibc's hosts default is "dns [!UNAVAIL=return] files" (dns
      # FIRST, /etc/hosts unreachable when DNS fails) and go's pure
      # resolver picks its own order — two resolvers, two behaviors.
      # "files dns" makes /etc/hosts authoritative everywhere and keeps
      # localhost working when DNS is denied. passwd/group/shadow are
      # files-only (the baked /etc/passwd set is the whole database).
      cat > $out/etc/nsswitch.conf <<'EOF'
      passwd: files
      group: files
      shadow: files
      hosts: files dns
      networks: files
      protocols: files
      services: files
      ethers: files
      rpc: files
      netgroup: files
      sudoers: files
      aliases: files
      publickey: files
      automount: files
      bootparams: files
      EOF

      # /etc/hosts fallback: container runtimes (docker, the OpenShell
      # VM driver) bind-mount their own /etc/hosts over this file, so
      # the baked copy only serves runtimes that don't. localhost must
      # resolve even then — the vscodium server binds loopback and
      # agents' local tools assume it.
      cat > $out/etc/hosts <<'EOF'
      127.0.0.1 localhost
      ::1 localhost ip6-localhost ip6-loopback
      EOF

      # Git identity + credential helper live in the HM profile
      # (programs.git in homeModules.profile-agent-base →
      # ~/.config/git/config at both $HOME roots) — user-level config
      # is what makes it reusable on NixOS hosts.

      # Minimal identity database: nix resolves the user's home via
      # getpwuid, and the vscodium server spawns shells for uid 1000.
      cat > $out/etc/passwd <<EOF
      root:x:0:0:System administrator:/root:${pkgs.bashInteractive}/bin/bash
      agent:x:1000:1000:Agent:/home/agent:${pkgs.bashInteractive}/bin/bash
      EOF
      cat > $out/etc/group <<EOF
      root:x:0:
      agent:x:1000:
      EOF
      echo 'root:!x:::::::' > $out/etc/shadow
      echo 'agent:!x:::::::' >> $out/etc/shadow

      # Foreign-glibc ELF support, replacing the old glibc-copy +
      # ld.so.cache approach (which never worked: nixpkgs glibc's
      # compiled-in cache path is its own read-only store etc/, so the
      # baked /etc/ld.so.cache was never read and the copied libs were
      # invisible at runtime):
      #  - nix-ld (github.com/nix-community/nix-ld):
      #    /lib64/ld-linux-x86-64.so.2 IS the shim; it reads NIX_LD (the
      #    real loader) and NIX_LD_LIBRARY_PATH (extra search dirs) from
      #    the env and runs the downloaded binary against the nix glibc.
      #  - /usr/lib/wheel-deps: libstdc++/libgcc_s/libz reachable via
      #    LD_LIBRARY_PATH (image Env + /etc/profile) so python3's
      #    manylinux wheel extensions (numpy, pillow, lxml, ...) resolve
      #    the handful of system libs they link at dlopen time. Scoped
      #    to those three libs on purpose: loader search order puts
      #    LD_LIBRARY_PATH before DT_RUNPATH, so a broader dir would
      #    shadow nix store libs process-wide. The agent runtimes are
      #    unaffected (pi's bun links no libstdc++; claude's node is
      #    smoke-tested against the shadow).
      ln -s ${pkgs.nix-ld}/libexec/nix-ld $out/lib64/ld-linux-x86-64.so.2
      ln -s ${pkgs.stdenv.cc.cc.lib}/lib/libstdc++.so.6 $out/usr/lib/wheel-deps/
      ln -s ${pkgs.stdenv.cc.cc.lib}/lib/libgcc_s.so.1 $out/usr/lib/wheel-deps/
      ln -s ${pkgs.zlib}/lib/libz.so.1 $out/usr/lib/wheel-deps/
    '';

    # Home, workdir, and the pre-baked per-agent wiring. Owned
    # 1000:1000 via perms below (OpenShell runs USER-less images as
    # UID/GID 1000; the image declares that user explicitly).
    agentDirs = pkgs.runCommand "code-agent-dirs" {} ''
      mkdir -p $out/home/agent $out/sandbox/.vscodium-server/bin
      # Pre-baked server at the path the jeanp413 open-remote-ssh
      # install script probes ($HOME/.vscodium-server with HOME=/sandbox
      # under the supervisor): script present means "already installed",
      # so connect is instant and offline.
      ln -s ${vscodium-server} $out/sandbox/.vscodium-server/bin/${vscodiumCommit}

      # Shell dotfiles at BOTH $HOME roots (see hmAgent above for why
      # ~/.bashrc is load-bearing: interactive ssh sessions are
      # `bash -i` and read nothing else). -rL dereferences HM's store
      # symlinks into real files so the layer is self-contained and the
      # perms block below can own them 1000:1000. NOTE: no host
      # directory is ever mounted over /sandbox (the VM driver has no
      # host-share mechanism; code-sandbox's --include-workdir is a
      # policy bit only) — /sandbox keeps these baked dotfiles and the
      # supervisor points HOME at it.
      cp -rL ${hmAgent.activationPackage}/home-files/. $out/sandbox/
      cp -rL ${hmAgent.activationPackage}/home-files/. $out/home/agent/
      # cp -rL preserves the store's read-only DIR perms (r-xr-xr-x) —
      # make the harvest writable so the image-level skills symlinks
      # below (and the agent configs' runtime siblings: claude's state
      # files, kimi sessions) can be created inside it.
      chmod -R u+w $out/sandbox $out/home/agent

      # pi/kimi/claude user configs (settings/models/mcp.json,
      # config.toml, settings.json + .claude.json, the per-agent
      # environment briefing) are home-manager-GENERATED — the hmAgent
      # home-files harvest above lands them at both $HOME roots. What
      # stays image-level: the skills SYMLINKS (a HM home.file symlink
      # would be dereference-COPIED by the harvest's cp -rL — the whole
      # tree, twice — so the absolute /opt/skills links live here).
      # The harvest already created .pi/agent, .kimi-code and .claude.
      ln -s /opt/skills $out/sandbox/.kimi-code/skills
      ln -s /opt/skills $out/home/agent/.kimi-code/skills
      ln -s /opt/skills $out/sandbox/.claude/skills
      ln -s /opt/skills $out/home/agent/.claude/skills

      # Agent Skills standard location, scanned by pi and claude-code
      # (and walked as a project-root skill dir from any /sandbox cwd).
      mkdir -p $out/sandbox/.agents $out/home/agent/.agents
      ln -s /opt/skills $out/sandbox/.agents/skills
      ln -s /opt/skills $out/home/agent/.agents/skills
    '';

    # Repo agent material baked read-only at /opt: the merged skills
    # tree (wired into pi/kimi/claude in agentDirs above).
    agentMaterial = pkgs.runCommand "code-agent-material" {} ''
      mkdir -p $out/opt
      cp -r ${skillsTree} $out/opt/skills
    '';

    # github-mcp-server wrapper: the attached github-agent provider
    # injects $GITHUB_TOKEN as an OPAQUE HANDLE (the gateway substitutes
    # the real secret at egress for profile-matched binaries — see
    # openshell/profiles/github-agent.yaml). github-mcp-server reads
    # GITHUB_PERSONAL_ACCESS_TOKEN, so map the handle onto it; nothing
    # secret lands in the image.
    sandboxGithubMcp = pkgs.writeShellScriptBin "github-mcp-server-sandbox" ''
      if [ -z "''${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ] && [ -n "''${GITHUB_TOKEN:-}" ]; then
        export GITHUB_PERSONAL_ACCESS_TOKEN="$GITHUB_TOKEN"
      fi
      exec ${lib.getExe pkgs.unstable.github-mcp-server} stdio "$@"
    '';

    # Headroom wrapper: the attached claude-code (platform key) provider
    # injects the bearer as $ANTHROPIC_AUTH_TOKEN, but headroom's
    # Anthropic client reads ANTHROPIC_API_KEY — map one onto the other
    # so `headroom mcp serve` can compress against api.anthropic.com
    # (already admitted by the policy). With the claude-subscription
    # provider instead ($CLAUDE_CODE_OAUTH_TOKEN) this mapping does not
    # fire ON PURPOSE: a subscription token only bills correctly on
    # Claude-Code-shaped requests, so headroom's raw-API LLM transforms
    # would 400 "credit balance too low" — without a key headroom falls
    # back to its local structural compressors, which is where the bulk
    # of the savings are anyway. headroom-slim (core+proxy+mcp)
    # is enough for the MCP server and keeps the image closure small.
    sandboxHeadroom = pkgs.writeShellScriptBin "headroom" ''
      if [ -z "''${ANTHROPIC_API_KEY:-}" ] && [ -n "''${ANTHROPIC_AUTH_TOKEN:-}" ]; then
        export ANTHROPIC_API_KEY="$ANTHROPIC_AUTH_TOKEN"
      fi
      exec ${lib.getExe pkgs.headroom-slim} "$@"
    '';

    # MCP servers baked into ALL sandbox agents' user configs (pi
    # ~/.pi/agent/mcp.json, kimi ~/.kimi-code/mcp.json, claude
    # ~/.claude/settings.json mcpServers — all three speak the same
    # claude-compatible {command, args} JSON shape): headroom (context
    # compression) and mcp-nixos (NixOS/Home Manager option search)
    # work offline-ish against already-admitted endpoints. github MCP
    # works too — but ONLY when the sandbox is created with the
    # github-agent provider attached (its profile admits the read-write
    # api.github.com endpoints and substitutes the credential at egress;
    # without the provider the server's calls are denied and it errors
    # on startup).
    sandboxMcpServers = {
      headroom = {
        command = "${sandboxHeadroom}/bin/headroom";
        args = ["mcp" "serve"];
      };
      nixos = {
        command = "${inputs'.mcp-nixos.packages.mcp-nixos}/bin/mcp-nixos";
        args = [];
      };
      github = {
        command = "${sandboxGithubMcp}/bin/github-mcp-server-sandbox";
        args = [];
      };
    };

    # One-line MCP server descriptions (pi lists them in the system
    # prompt's mcp_servers section and ranks tool_search matches by
    # them).
    sandboxMcpDescriptions = {
      headroom = "Context compression for the conversation: compress/retrieve/stats.";
      nixos = "NixOS, Home Manager and nix-darwin option and package search.";
      github = "GitHub repos, issues, PRs; requires the github-agent provider attached at sandbox creation.";
    };

    # ONE headroom proxy per sandbox for inference routing: a proxy
    # process has a single Anthropic-wire upstream target, and each
    # sandbox is dedicated to one coding agent at create time
    # (code-sandbox --agent pi|kimi|claude stamps $CODE_AGENT into the
    # create-time env — the channel that survives the supervisor's env
    # scrub). The first launcher wrapper to run lazy-starts the proxy
    # with its routing family's upstream:
    #   pi / kimi → api.kimi.com/coding (kimi-for-coding subscription;
    #               Anthropic-wire for both, verified live 2026-10)
    #   claude    → api.anthropic.com (the proxy's default target)
    # Verified in-sandbox: ~5s cold start, ~365MB RSS (slim),
    # compressed real traffic on first contact.
    headroomPort = 8787;
    headroomKimiUpstream = "https://api.kimi.com/coding";

    # Proxy lazy-start: no systemd in the microVM, so the first agent
    # invocation brings its proxy up (flock serializes the startup
    # race; the agent never blocks on a failed proxy — it execs
    # regardless and the baked baseUrl then fails fast with a
    # connection error naming the port). $1 = port, $2 = optional
    # anthropic-pipeline upstream override (empty = api.anthropic.com).
    # --stateless: no filesystem writes (containerized mode; the CCR
    # store + stats live in memory for the sandbox's lifetime).
    # --disable-kompress: the image ships headroom-slim (no [ml]
    # extra), and kompress's ModernBERT model downloads from
    # huggingface.co, which the sandbox policy deliberately does NOT
    # admit — without the flag the proxy idles "degraded" on every
    # /health. The structural compressors (smart_crusher, log, code —
    # where the measured savings are) stay enabled.
    # Telemetry/update-check off: their hosts are deliberately not
    # policy-admitted.
    headroomProxyEnsure = pkgs.writeShellScriptBin "headroom-proxy-ensure" ''
      port="$1"
      upstream="''${2:-}"
      ensure() {
        ${pkgs.curl}/bin/curl -sf "http://127.0.0.1:$port/livez" >/dev/null 2>&1 && return 0
        ${pkgs.util-linux}/bin/flock -w 30 9 || return 0
        ${pkgs.curl}/bin/curl -sf "http://127.0.0.1:$port/livez" >/dev/null 2>&1 && return 0
        export HEADROOM_BEACON=off HEADROOM_UPDATE_CHECK=off
        if [ -n "$upstream" ]; then
          export ANTHROPIC_TARGET_API_URL="$upstream"
        fi
        nohup ${sandboxHeadroom}/bin/headroom proxy --stateless --disable-kompress --port "$port" \
          >>"/tmp/headroom-proxy-$port.log" 2>&1 &
        for _ in $(${pkgs.coreutils}/bin/seq 1 60); do
          ${pkgs.curl}/bin/curl -sf "http://127.0.0.1:$port/livez" >/dev/null 2>&1 && return 0
          sleep 0.5
        done
        return 0
      }
      ensure 9>"/tmp/headroom-proxy-$port.lock"
      exit 0
    '';

    # Workspace-trust pre-seed for kimi-code and claude-code: both gate
    # project-level features (project MCP servers, project settings)
    # behind an interactive per-folder trust prompt, and both persist
    # trust per ABSOLUTE PATH with no wildcard support — kimi as JSON
    # records in $KIMI_CODE_HOME/workspace-trust/wd_<slug>_<sha256(cwd)
    # [:12]> (trustRecord.ts in kimi-code 2.1.1), claude as
    # projects[<cwd>].hasTrustDialogAccepted in ~/.claude.json. This
    # script marks the cwd — plus its git toplevel, since kimi's
    # workspace root may resolve to the repo root — trusted when it
    # lives under /sandbox (the disposable sandbox IS the trust
    # boundary). Verified live in-sandbox 2026-10 against both CLIs'
    # interactive trust prompts.
    agentPreTrust = pkgs.writeText "agent-pretrust.py" ''
      import fcntl
      import hashlib
      import json
      import os
      import re
      import subprocess
      import sys
      import time

      SANDBOX_ROOT = "/sandbox"


      def targets():
          cwd = os.getcwd()
          out = [cwd]
          try:
              top = subprocess.run(
                  ["git", "rev-parse", "--show-toplevel"],
                  capture_output=True,
                  text=True,
                  timeout=5,
              ).stdout.strip()
              if top:
                  out.append(top)
          except Exception:
              pass
          return [
              p
              for p in dict.fromkeys(out)
              if p == SANDBOX_ROOT or p.startswith(SANDBOX_ROOT + "/")
          ]


      def kimi_trust(dirs):
          home = os.environ.get("KIMI_CODE_HOME") or os.path.join(
              os.path.expanduser("~"), ".kimi-code"
          )
          store = os.path.join(home, "workspace-trust")
          os.makedirs(store, exist_ok=True)
          for d in dirs:
              norm = d.replace("\\", "/").rstrip("/") or "/"
              slug = re.sub(r"[^a-z0-9._-]+", "-", norm.split("/")[-1].lower())
              slug = slug.strip("-")[:40].strip("-")
              if slug in ("", ".", ".."):
                  slug = "workspace"
              key = f"wd_{slug}_{hashlib.sha256(norm.encode()).hexdigest()[:12]}"
              path = os.path.join(store, key)
              if not os.path.exists(path):
                  with open(path, "w") as f:
                      json.dump({"root": norm, "trustedAt": int(time.time() * 1000)}, f)


      def claude_trust(dirs):
          path = os.path.join(os.path.expanduser("~"), ".claude.json")
          os.makedirs(os.path.dirname(path), exist_ok=True)
          with open(path, "a+") as f:
              fcntl.flock(f, fcntl.LOCK_EX)
              f.seek(0)
              try:
                  data = json.load(f)
              except Exception:
                  data = {}
              projects = data.setdefault("projects", {})
              for d in dirs:
                  projects.setdefault(d, {})["hasTrustDialogAccepted"] = True
              f.seek(0)
              f.truncate()
              json.dump(data, f, indent=2)


      if __name__ == "__main__":
          dirs = targets()
          if dirs:
              {"kimi": kimi_trust, "claude": claude_trust}[sys.argv[1]](dirs)
    '';

    # Agent launcher wrappers: gate on the sandbox's stamped agent,
    # ensure the (single) headroom proxy, verify its upstream matches
    # this agent's routing family, run the agent's pre-exec setup
    # (trust pre-seed, messaging socket), then exec the real CLI —
    # /proc/pid/exe resolves to the REAL binary, so the policy's binary
    # pins (pi ELF, the node wildcard, .claude-wrapped) keep matching.
    #
    # One coding agent per sandbox: code-sandbox --agent stamps
    # $CODE_AGENT at create time (the create-time --env set survives
    # the supervisor's env scrub, unlike the image Env). pi and kimi
    # share the "kimi" routing family (same upstream, same credential).
    # A launcher from the wrong family would silently misroute through
    # a proxy bound to the OTHER upstream and fail with a bare 401 —
    # refuse loudly instead. Unset CODE_AGENT (plain docker run, older
    # code-sandbox) skips the gate; the /health upstream check below
    # still catches a misbound proxy.
    mkAgentLauncher = name: realBin: family: upstream: preExec: let
      expectedUpstream =
        if upstream == ""
        then "https://api.anthropic.com"
        else upstream;
      allowedAgents =
        if family == "claude"
        then ''"" | claude''
        else ''"" | pi | kimi'';
    in
      pkgs.writeShellScriptBin name ''
        case "''${CODE_AGENT:-}" in
          ${allowedAgents}) ;;
          *)
            echo "${name}: this sandbox was created for CODE_AGENT='$CODE_AGENT' — ${name} routes to ${expectedUpstream}, which this sandbox's headroom proxy does not serve." >&2
            echo "Create a dedicated sandbox instead:  code-sandbox --agent ${family} create" >&2
            exit 1
            ;;
        esac
        ${headroomProxyEnsure}/bin/headroom-proxy-ensure ${toString headroomPort} "${upstream}"
        # Belt-and-braces: a proxy started by a different-family
        # launcher (or by hand with the wrong upstream) must never
        # silently misroute this agent's traffic.
        proxyUpstream="$(${pkgs.curl}/bin/curl -sf "http://127.0.0.1:${toString headroomPort}/health" 2>/dev/null | ${pkgs.python3}/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["checks"]["upstream"]["url"])' 2>/dev/null || true)"
        if [ -n "$proxyUpstream" ] && [ "$proxyUpstream" != "${expectedUpstream}" ]; then
          echo "${name}: headroom proxy on 127.0.0.1:${toString headroomPort} is bound to $proxyUpstream, but ${name} needs ${expectedUpstream}." >&2
          echo "Kill the stale proxy (pkill -f 'headroom proxy') or recreate with:  code-sandbox --agent ${family} create" >&2
          exit 1
        fi
        ${preExec}
        exec ${realBin} "$@"
      '';
    sandboxPi = mkAgentLauncher "pi" "${pkgs.pi-coding-agent}/bin/pi" "kimi" headroomKimiUpstream "";
    sandboxKimi = mkAgentLauncher "kimi" "${pkgs.kimi-code}/bin/kimi" "kimi" headroomKimiUpstream ''
      # Pre-trust /sandbox folders (see agentPreTrust): kimi's startup
      # gate prompts per folder otherwise and project MCP servers stay
      # disabled while untrusted.
      ${pkgs.python3}/bin/python3 ${agentPreTrust} kimi 2>/dev/null || true
    '';
    sandboxClaude = mkAgentLauncher "claude" "${pkgs.claude-code}/bin/claude" "claude" "" ''
      # Pre-trust /sandbox folders (see agentPreTrust).
      ${pkgs.python3}/bin/python3 ${agentPreTrust} claude 2>/dev/null || true
      # Cross-session messaging: '/' in this microVM is owned by the
      # host's overflow ids (991:987, not root), so claude's sockets-dir
      # component walk ("owned by you or root") refuses EVERY
      # auto-generated location — XDG_RUNTIME_DIR included (verified
      # 2026-10 via --debug-file). The escape hatch is an explicit
      # --messaging-socket-path, which skips the '/' walk: a unique
      # socket per session inside one shared private dir (the dir is
      # the rendezvous — the default behavior also uses per-session
      # sockets under a shared dir; two sessions on ONE fixed path
      # collide and the second exits 1).
      claudeMsgDir=/tmp/claude-code-messaging
      if ${pkgs.coreutils}/bin/install -d -m 700 "$claudeMsgDir" 2>/dev/null; then
        set -- --messaging-socket-path "$claudeMsgDir/sock-$$-$RANDOM" "$@"
      fi
    '';

    # The sandbox's mandatory agent defaults as a home-manager module:
    # homeSpec.agents.* (homeModules/agents.nix) renders the MCP trio,
    # the provider wiring and the headroom-proxy routing into the
    # agents' config FILES (~/.pi/agent, ~/.kimi-code, ~/.claude) — the
    # only channel that survives the supervisor's process-env scrub
    # (HM sessionVariables are force-emptied in profile-agent; the
    # image Env never reaches in-VM processes).
    hmAgentSandboxModule = {lib, ...}: {
      homeSpec.agents = {
        # /opt/skills symlinks stay image-level (see agentDirs).
        skills.enabled = false;
        mcp = {
          # The sandbox pins its own trio (env-mapping credential
          # wrappers + inputs'.mcp-nixos) — the host-oriented toggles
          # stay off.
          nixos.enable = false;
          github.enable = false;
          headroom.enable = false;
          extraServers =
            lib.mapAttrs (name: server: {
              command = [server.command] ++ server.args;
              description = sandboxMcpDescriptions.${name};
              exposure = "direct";
            })
            sandboxMcpServers;
        };
        pi = {
          enabled = true;
          installPackage = false;
          settings = {
            # The baked skills tree as an explicit resource path
            # (absolute paths supported; resolves regardless of HOME).
            skills = ["/opt/skills"];
            # Startup defaults. The image Env's PI_PROVIDER/PI_MODEL do
            # NOT survive the supervisor's env scrub — settings.json is
            # the file channel that does.
            defaultProvider = "kimi-coding";
            defaultModel = "kimi-for-coding";
            defaultThinkingLevel = "max";
            # The disposable sandbox is the trust boundary: don't gate
            # .pi project config behind an interactive trust prompt.
            defaultProjectTrust = "always";
          };
          models.providers = {
            # kimi-for-coding subscription, key from the
            # provider-injected $KIMI_API_KEY, routed through the
            # sandbox's single headroom proxy. A baseUrl-only override
            # preserves pi's built-in model catalog for the provider
            # (pi custom-provider docs).
            kimi-coding = {
              apiKey = "$KIMI_API_KEY";
              baseUrl = "http://127.0.0.1:${toString headroomPort}";
            };
            # Claude models ride the claude-code PLATFORM provider's
            # $ANTHROPIC_AUTH_TOKEN through the same single proxy —
            # which only works in a sandbox created with `--agent
            # claude` (the proxy's upstream is per-sandbox). Under the
            # default claude-subscription provider this var is unset
            # and the provider fails fast on use — ON PURPOSE: a
            # subscription OAuth token only bills on Claude-Code-shaped
            # requests; pi's raw /v1/messages calls 429 against it
            # (verified live in-sandbox 2026-10), so there is nothing
            # to route here without the platform key.
            anthropic = {
              apiKey = "$ANTHROPIC_AUTH_TOKEN";
              baseUrl = "http://127.0.0.1:${toString headroomPort}";
            };
          };
          appendSystemMd = sandboxContext-pi;
        };
        kimi = {
          enabled = true;
          installPackage = false;
          # snake_case keys: kimi-code 2.1.1 accepts both conventions
          # (camelCase is the legacy alias set), but newer sections
          # (secondary_model, support_efforts) only exist in the
          # snake_case schema — verified live in-sandbox 2026-10
          # (kimi doctor + k3 session through the headroom proxy).
          config = {
            # k3 at high thinking effort is the sandbox default; all
            # models ride the same Kimi for Coding subscription over
            # the Anthropic wire through the headroom proxy (type
            # "anthropic" verified live in-sandbox 2026-10 — the kimi
            # wire, OpenAI-style chat completions, is not proxyable).
            default_model = "k3";
            # kimi 2.1.1 permission modes (verified via `kimi --help`):
            # "yolo" = Ask When Needed (routine actions run, risky
            # ones still ask), "auto" = Never Ask (never interrupts).
            # The sandbox default is Never Ask — the microVM is the
            # isolation boundary.
            default_permission_mode = "auto";
            providers.kimi-for-coding = {
              type = "anthropic";
              base_url = "http://127.0.0.1:${toString headroomPort}";
              api_key_env = "KIMI_API_KEY";
            };
            models = {
              k3 = {
                provider = "kimi-for-coding";
                model = "k3";
                max_context_size = 1048576;
                capabilities = ["thinking" "always_thinking" "image_in" "video_in" "tool_use"];
                support_efforts = ["low" "high" "max"];
                default_effort = "high";
              };
              kimi-for-coding = {
                provider = "kimi-for-coding";
                model = "kimi-for-coding";
                max_context_size = 262144;
                capabilities = ["thinking" "always_thinking" "image_in" "video_in" "tool_use"];
              };
              kimi-for-coding-highspeed = {
                provider = "kimi-for-coding";
                model = "kimi-for-coding-highspeed";
                max_context_size = 262144;
                capabilities = ["thinking" "always_thinking" "image_in" "video_in" "tool_use"];
              };
            };
            thinking = {
              enabled = true;
              effort = "high";
            };
            # Subagents default to the fast model; the pool lets the
            # main agent escalate per spawn (k3 for hard problems).
            secondary_model = {
              default_model = "kimi-for-coding-highspeed";
              models = {
                k3 = "Pick this for hard problems. Strong at complex reasoning, algorithm design, deep debugging, math, and systematic challenges.";
                kimi-for-coding-highspeed = "Fast but priced higher. Good for latency-sensitive tasks: daily refactoring, code explanation, small edits, and summaries.";
                kimi-for-coding = "A balanced coding workhorse. Good for most feature development and code-change tasks.";
              };
            };
            identity = {
              name = "code-agent";
              slug = "code-agent";
            };
            # MCP permission rules: redundant under Never Ask but kept
            # as documentation and for sessions started in another mode.
            permission.rules = [
              {
                decision = "allow";
                pattern = "mcp__nixos__*";
              }
              {
                decision = "allow";
                pattern = "mcp__headroom__*";
              }
            ];
          };
          systemMd = sandboxContext-kimi;
        };
        claude = {
          enabled = true;
          installPackage = false;
          settings = {
            hasCompletedOnboarding = true;
            theme = "dark";
            # Opus 5.5 as the default model (subscription-billed via
            # $CLAUDE_CODE_OAUTH_TOKEN; verified live in-sandbox
            # 2026-10 through the headroom proxy).
            model = "claude-opus-5-5";
            # Never-ask default for the disposable sandbox. Only takes
            # effect from USER settings (which this is) — project/local
            # files can't set bypassPermissions since claude v2.1.257.
            # "auto" is the softer classifier-driven alternative (never
            # asks, but silently blocks what it judges risky).
            permissions.defaultMode = "bypassPermissions";
            # Route claude through the sandbox's single headroom
            # proxy (its upstream is per-sandbox: a claude sandbox
            # binds api.anthropic.com). The settings.json env block
            # applies to claude's own process — the file channel
            # survives the supervisor's env scrub (HM sessionVariables
            # would not).
            env.ANTHROPIC_BASE_URL = "http://127.0.0.1:${toString headroomPort}";
          };
          # Bake ~/.claude.json too (claude merges either file) so the
          # onboarding skip survives claude rewriting its state file.
          writeClaudeJson = true;
          claudeMd = sandboxContext-claude;
        };
      };
    };

    # Flake revision baked into the briefing's Image line, pinpointing
    # the image generation a sandbox runs. NOTE: flake-parts' self' is
    # the perSystem-narrowed view and carries no sourceInfo — the real
    # self (with shortRev) arrives via inputs.self (shortRev is absent
    # on non-git evals and null on dirty trees).
    imageRev =
      if inputs.self ? shortRev && inputs.self.shortRev != null
      then inputs.self.shortRev
      else "dirty";

    # Search dirs for the nix-ld shim's NIX_LD_LIBRARY_PATH (foreign
    # glibc binaries): the store lib dirs themselves — no FHS copies.
    nixLdLibs = lib.makeLibraryPath [pkgs.glibc pkgs.stdenv.cc.cc.lib pkgs.zlib];

    # Environment briefing baked into every agent's system prompt /
    # memory: what this sandbox is, what works here and what does not.
    # Kept deliberately terse — it is tokens in every session. One
    # parameterized template, three renderings — the per-agent deltas
    # are the identity line and the Agent notes section:
    # - agentName: only kimi interpolates ''${product_name} (from
    #   [identity].name in the baked kimi config below), so pi and
    #   claude get their real product names baked while kimi keeps the
    #   live slot.
    # - notes: short per-agent MCP/diagnostics pointers.
    # Spots: pi ~/.pi/agent/APPEND_SYSTEM.md (adds to Pi's system
    # prompt, pi configuration docs), kimi-code ~/.kimi-code/SYSTEM.md
    # ($KIMI_CODE_HOME/SYSTEM.md, kimi configuration docs), claude-code
    # ~/.claude/CLAUDE.md (user-level memory loaded every session) —
    # at BOTH $HOME roots (the supervisor points HOME at /sandbox,
    # plain docker runs at /home/agent).
    sandboxContext = agentName: notes: ''
      # Sandbox environment

      You are ${agentName}, running inside an OpenShell code-agent sandbox: an isolated microVM with deny-by-default network egress, running as uid 1000 (agent), workdir /sandbox, HOME=/home/agent. Image: code-agent @ ${imageRev}.

      ## Toolset
      A full toolset is pre-baked on PATH (/bin, /usr/bin, /usr/local/bin): shell + coreutils, git/gh, curl/wget/jq/yq, python3 + uv, go, bun, ripgrep/fd/sd/tmux/less, which/clear, archive + foreign-ELF tools (file/readelf/objdump/ldd), kubectl/helm, shellcheck/shfmt, nix (+ nixd/alejandra/statix/deadnix), the clan CLI, and the pi/kimi/claude CLIs. The user-level toolset + dotfiles + the pi/kimi/claude user configs (MCP servers, provider wiring, proxy routing) come from a baked home-manager evaluation (homeModules.profile-agent-base + the profile-agent OCI flavor + homeSpec.agents); the system layer (/etc, nix-ld, terminfo, coreutils) is image-level.

      - Use baked tools directly. NEVER `nix run` or `nix profile install` a package that is already installed.
      - The nix store is single-user and WRITABLE by design
        (`nixUid`/`nixGid` 1000 in the image spec, and the sandbox
        filesystem policy marks /nix read_write): additions through
        nix itself (`nix build`, `nix profile install`, substitutions)
        are normal and expected. Never add or remove store paths
        BEHIND nix's back — raw `cp`/`rm` in /nix/store desyncs the
        db and breaks later nix runs; repair is a sandbox restart.
      - Plain nix builds run at NATIVE speed — the microVM is
        KVM-backed on the host (the repo's `checks.lint` builds here
        in seconds). The hard limits are: no /dev/kvm in the guest
        (NixOS VM tests and nested VMs are CI's job — never
        `nix run .#vm-test`), no `nixos-rebuild`, and FOD/source
        fetches are policy-gated to the admitted hosts. If nix starts
        building a LARGE package from source (llvm/rustc-class), stop
        it — substitute instead; big source builds also eat the 32 GiB
        overlay.
      - nix ALWAYS warns "you don't have Internet access" in this
        sandbox — that is a `getifaddrs()` heuristic (the microVM has
        no routable interface), NOT a network failure. Substitution to
        the admitted caches works: ALWAYS pass `--option substitute
        true` to `nix build` / `nix flake check` here (e.g. `nix build
        --option substitute true .#checks.x86_64-linux.lint -L`).
        Without the override, cache hits degenerate into doomed
        from-source builds (recipe: **sandbox-environment** skill).
      - Flakes evaluate from the GIT TREE: `git add` new/changed files
        BEFORE `nix build` / `nix flake check` — untracked files do
        not exist to Nix.
      - In a nix repo, before declaring work done: `git add` everything
        new, then run the repo's lint loop (`alejandra --check`,
        `statix check`, `deadnix --fail`, or the flake's `checks.lint`
        via `nix build --option substitute true .#checks.<system>.lint
        -L`), then the lightest real build/eval that covers the
        change. Full `nix flake check` is allowed (checks only; VM
        tests are legacyPackages and never part of it) but evaluates
        every output — prefer the targeted gate when iterating.
      - Python: `python3` ships WITHOUT global pip — bootstrap it with
        `python3 -m venv`, or prefer the baked `uv` (wheel-first).
        PyPI (`pypi.org` + `files.pythonhosted.org`) is admitted
        READ-ONLY for python3/uv. Install WHEELS ONLY: no C toolchain
        ships here, so sdists that compile cannot build in-sandbox —
        get those via nix substitution (`nix run --option substitute
        true nixpkgs#…`). The baked ~/.config/uv/uv.toml (HM
        profile-agent) already enforces this: python-downloads=never
        + python-preference=only-system (baked python3 only — other
        versions via nixpkgs), no-build + pip.only-binary=":all:"
        (sdist compiles fail fast; per-command override: uv pip
        install --only-binary :none: inside `nix shell nixpkgs#gcc`).
        Binary wheels import as-is: the few
        system libs they link (libstdc++/libgcc_s/libz) resolve from
        the baked /usr/lib/wheel-deps dir (on LD_LIBRARY_PATH).
      - Foreign glibc binaries (downloaded FHS ELFs) run via the
        nix-ld shim: /lib64/ld-linux-x86-64.so.2 reads NIX_LD and
        NIX_LD_LIBRARY_PATH from the env.
      - Shell environment: login/exec shells (`bash -lc`, how ssh remote
        commands and `openshell sandbox exec` run) read /etc/profile;
        interactive ssh/editor-terminal shells are `bash -i` and read
        ~/.bashrc (baked at both $HOME roots, sources /etc/profile).
        Both are idempotent. The OCI image Env does NOT survive the
        supervisor's env scrub — TLS vars and provider credentials are
        injected per-process, and the create-time --env set (passed by
        code-sandbox) covers the rest. The full terminfo db (ncurses +
        ghostty) lives at /usr/share/terminfo; TERM arrives verbatim
        from the client's pty request.
      - Do NOT run the NixOS VM tests (`nix run .#vm-test`): they need /dev/kvm, which the guest does not have. VM tests are CI's job — flag the gap rather than running them.

      ## MCP servers
      Pre-configured in every agent's user-level MCP config (pi ~/.pi/agent/mcp.json, kimi ~/.kimi-code/mcp.json, claude ~/.claude/settings.json): **headroom** (context compression), **nixos** (NixOS / Home Manager option search), **github** (repos / issues / PRs — only functional when the sandbox was created with the github-agent provider attached). There is deliberately NO kubernetes MCP server; use kubectl/helm directly.

      ## Headroom proxy
      ALL agent inference routes through ONE local headroom proxy (context compression → token savings) on http://127.0.0.1:8787, lazy-started by each agent's launcher wrapper with the upstream for the sandbox's stamped agent ($CODE_AGENT, set by `code-sandbox --agent` at create time): pi/kimi → https://api.kimi.com/coding, claude → https://api.anthropic.com (the proxy's default target). Kompress (the optional ML compressor) is disabled — its model host is not policy-admitted; the structural compressors carry the savings. If an agent fails with a 127.0.0.1 connection error, start the proxy: `headroom-proxy-ensure 8787` (claude) / `headroom-proxy-ensure 8787 https://api.kimi.com/coding` (pi/kimi). Logs at /tmp/headroom-proxy-8787.log; `headroom doctor` health-checks; savings show in `curl -s 127.0.0.1:8787/stats` (`--stateless` keeps no on-disk ledger, so `headroom savings` stays empty by design).

      ## Skills
      /opt/skills holds the repo's merged skill tree (repo skills/ + external sources), wired into pi, kimi and claude. Load with /skill:<name>; read a SKILL.md before relying on a skill. The **sandbox-environment** skill carries this sandbox's deep reference (full egress list, cache keys, recipes).

      ## Network
      Egress is deny-by-default and matches (binary, host) PAIRS. Admitted: github.com (read + api), the nix cache estates (*.nixos.org, *.cachix.org, clan's cache.geninf.io/cache.clan.lol), flake-input hosts for nix/git fetches (git.clan.lol read-write, code.m3ta.dev read-only, api.flakehub.io/api.flakehub.com, files.pythonhosted.org for the headroom wheel input), PyPI (pypi.org + files.pythonhosted.org) for python3/uv, the Go module proxy + checksum db (proxy.golang.org/sum.golang.org) for go, api.kimi.com, api.anthropic.com, platform.claude.com. A host admitted for ONE binary is not admitted for others (e.g. PyPI is python3/uv-only; curl is refused). Everything else is DENIED — do not retry dead hosts in a loop; report the blocked host. Full host/rule list: **sandbox-environment** skill.

      ## Identity and secrets
      - Git commits are authored as the andrewthomaslee-agent bot.
      - No secrets are baked into the image. API keys arrive via attached providers: $KIMI_API_KEY (kimi), $ANTHROPIC_AUTH_TOKEN (claude-code platform provider) or $CLAUDE_CODE_OAUTH_TOKEN (claude-subscription provider — the default; never attach both, the bearer shadows it), $GITHUB_TOKEN (git credential helper).
      - This is a clean sandbox, NOT a checkout of the home repo — clone github.com/external-systems/home if repo work is needed.

      ## Troubleshooting
      - github MCP errors at startup → the sandbox was created without the github-agent provider attached; headroom/nixos are unaffected.
      - nix starts building a package from source → stop it; use the baked tool (or a substituter key is missing — report it).
      - A host is DENIED → report it instead of retrying; the policy hot-reloads (`openshell policy set` from the host), no sandbox recreation needed. Host-side diagnosis: `openshell logs <sandbox> --source sandbox | grep -iE 'denied|reject|block|forbidden'` (plain `openshell logs <name>` is flooded by known upstream supervisor ssh WARNs — `data on unknown channel` — ignore those).
      - An admitted-LOOKING host refusing connections instantly (`Could not connect to server`) usually means the (binary, host) PAIR is missing from the policy, not a network failure — and the deny log is not authoritative (observed 2026-10: nix→files.pythonhosted.org refused with NO deny line; that host was admitted only for python3/uv, fixed in this policy revision). Check the pair against the sandbox's composed policy from the host before concluding drift. Rare one-off refuses on genuinely admitted pairs (observed once for nix→github.com) are proxy-level flakes: retry once or twice (self-recovers within minutes), then report.
      - `error: killing process ...: Operation not permitted` during nix builds is the supervisor's seccomp blocking nix→builder signals — cosmetic; the build result stands.
      - The gateway MITMs TLS with a per-gateway supervisor CA (mounted at /run/openshell-supervisor-ca/material/): interactive tools work via the injected SSL_CERT_FILE, nix BUILDERS run with a scrubbed env — covered by the baked /etc/ssl/certs/ca-certificates.crt symlink (go's first probe path) and NIX_SSL_CERT_FILE from /etc/profile (FODs inherit it via impureEnvVars; git/curl fetchers hang off it).
      - `ls /` fails (EACCES): the sandbox filesystem policy marks /bin /usr /lib /lib64 /etc /opt /proc read_only and /sandbox /tmp /nix /home read_write, and `/` itself is in neither list — deny by default, so it cannot be listed. Every real path below it works normally.

      ## Agent notes

      ${notes}
    '';

    sandboxContext-pi = sandboxContext "pi" ''
      - MCP exposure: all three servers are `direct` — their tools are listed in the system prompt at session start; the github server still needs the github-agent provider attached to answer calls. Diagnose servers with `pi mcp list`; add project-only servers with `pi mcp add -l <name> -- <cmd>`.
      - Defaults (baked ~/.pi/agent/settings.json): kimi-coding/kimi-for-coding at max thinking; project trust auto-granted. A claude provider (anthropic, via the same :8787 proxy) is wired too, but only works in a `--agent claude` sandbox with the claude-code PLATFORM provider attached ($ANTHROPIC_AUTH_TOKEN) — the subscription token 429s on pi's raw-API request shape.
    '';

    sandboxContext-kimi = sandboxContext "\${product_name}" ''
      - Inspect MCP connections with `/mcp`. Sessions start in Never Ask mode (default_permission_mode = "auto"); folders under /sandbox are pre-trusted by the launcher wrapper.
      - Default model is k3 at high thinking effort; subagents default to kimi-for-coding-highspeed (pool: k3 / kimi-for-coding / kimi-for-coding-highspeed, `/secondary-model` to change).
    '';

    sandboxContext-claude = sandboxContext "Claude Code" ''
      - Inspect MCP connections with `/mcp`. Servers ride the baked ~/.claude/settings.json mcpServers table; ~/.claude.json is claude's mutable state file and stays writable.
      - Defaults (baked settings.json): model claude-opus-5-5, permissions.defaultMode bypassPermissions. Folders under /sandbox are pre-trusted by the launcher wrapper, which also passes a per-session --messaging-socket-path (the auto socket-dir walk refuses '/' — owned by the VM host's overflow ids — so cross-session messaging would stay off otherwise).
    '';

    tmpDir = pkgs.runCommand "code-agent-tmp" {} "mkdir -p $out/tmp";

    # Multiline nix config: flakes on; the microVM is the isolation
    # boundary and the OpenShell supervisor's seccomp stack blocks nix's
    # builder-child filter ("unable to load seccomp BPF program:
    # Operation not permitted"), so builders skip their own filter.
    # Substituters: the repo's own cachix caches (openshell — this
    # flake's closure — plus devenv/nix-community/chaotic-nyx,
    # mirroring flake.nix's nixConfig minus cache.numtide.com, whose
    # host the sandbox policy does not admit) and clan-core's niks3
    # cache (cache.geninf.io; objects may be signed under either
    # cache.geninf.io-1 or cache.clan.lol-1, so both keys are trusted —
    # keys verbatim from the cache's own usage page). The FlakeHub
    # binary caches were dropped: they answer nix-cache-info with 401
    # Unauthorized anonymously, so they were dead substituters adding
    # warning noise to every nix invocation (api.flakehub.io stays
    # admitted in the sandbox policy for flakehub: inputs — verified
    # 401-in-sandbox, 2026-10). Baked at BOTH /etc/nix/nix.conf (rootfs
    # below) and $NIX_CONFIG (image Env below). NOTE (verified live
    # 2026-10): the supervisor does NOT pass the image Env's NIX_CONFIG
    # through to the sandbox process env — it rewrites Env wholesale
    # (SSL_CERT_FILE arrives pointed at the supervisor CA bundle), so
    # /etc/nix/nix.conf is the ONLY copy guaranteed in effect under
    # OpenShell; $NIX_CONFIG remains for plain docker runs.
    nixConfig = lib.concatStringsSep "\n" [
      "experimental-features = nix-command flakes"
      "sandbox = false"
      "filter-syscalls = false"
      # The gateway proxy occasionally refuses an admitted (binary, host)
      # pair with an instant "Could not connect to server" that
      # self-recovers within a minute (observed 2026-10 for
      # nix→github.com input tarballs). Retry downloads and allow a
      # sane connect window so these flakes self-heal instead of
      # failing the eval.
      "connect-timeout = 10"
      "download-attempts = 3"
      "extra-substituters = https://openshell.cachix.org/ https://devenv.cachix.org/ https://nix-community.cachix.org/ https://chaotic-nyx.cachix.org/ https://cache.geninf.io/"
      "extra-trusted-public-keys = openshell.cachix.org-1:OAr5MunsfH5PZvUsfD08OtGx5RtcwdNZGJdU5FqLm5w= devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw= nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs= chaotic-nyx.cachix.org-1:HfnXSw4pj95iI/n8ae7W70yP3m9y9633ndgliTLGsQI= cache.geninf.io-1:uhEViaczNKSoerYM+w7uqXUzlAhnbEBKsFzgg9n3cvI= cache.clan.lol-1:3KztgSAB5R1M+Dz7vzkBGzXdodizbgLXGXKXlcQLA28="
    ];
  in {
    packages = {
      # Create-time sandbox environment (`openshell sandbox create
      # --env KEY=VALUE`, one per line — code-sandbox create passes
      # them): the supervisor spawns every sandbox process with a
      # SCRUBBED env (env_clear: only HOME/USER/PATH/TERM/SHELL +
      # injected TLS vars + provider creds), so the image Env above
      # never reaches in-VM sandbox processes. Shells recover the
      # runtime env from /etc/profile and the baked ~/.bashrc, but spec
      # env is the ONLY channel that covers EVERY spawn path —
      # including `bash -i` interactive ssh sessions (whose HOME is the
      # workdir /sandbox) and non-shell exec consumers (SDKs). Keep it
      # free of
      # runtime-dependent values: NIX_SSL_CERT_FILE stays out on
      # purpose (the supervisor injects the TLS bundle paths itself;
      # /etc/profile has the plain-docker fallback).
      code-agent-env = pkgs.writeText "code-agent-env" ''
        LD_LIBRARY_PATH=/usr/lib/wheel-deps
        NIX_LD=${pkgs.glibc}/lib/ld-linux-x86-64.so.2
        NIX_LD_LIBRARY_PATH=${nixLdLibs}
        TERMINFO_DIRS=/usr/share/terminfo:${pkgs.ncurses}/share/terminfo
        XDG_RUNTIME_DIR=/tmp/xdg-runtime-1000
      '';

      code-agent-image = n2c.buildImage {
        name = "code-agent";
        tag = "latest";

        copyToRoot = [baseTools rootfs agentDirs agentMaterial tmpDir];

        # Register the image store paths in the nix db at build time so
        # `nix` works in-sandbox without a db init.
        initializeNixDatabase = true;
        nixUid = 1000;
        nixGid = 1000;

        maxLayers = 128;

        perms = [
          {
            path = agentDirs;
            regex = ".*";
            # nix store defaults are 0555; without an explicit mode the
            # workdir would be read-only for the runtime user.
            mode = "0755";
            uid = 1000;
            gid = 1000;
            uname = "agent";
            gname = "agent";
          }
          {
            path = tmpDir;
            regex = "/tmp";
            mode = "1777";
            uid = 0;
            gid = 0;
            uname = "root";
            gname = "root";
          }
        ];

        config = {
          User = "agent";
          WorkingDir = "/sandbox";
          # OCI provenance labels: which repo (and which commit of it)
          # built this image. `docker inspect` / skopeo answer the
          # provenance question without the in-image briefing.
          Labels = {
            "org.opencontainers.image.title" = "code-agent";
            "org.opencontainers.image.description" = "General-purpose OpenShell coding sandbox image (nix + agent CLIs + baked toolset), built with nix2container from external-systems/home.";
            "org.opencontainers.image.source" = "https://github.com/external-systems/home";
            "org.opencontainers.image.revision" = imageRev;
            "org.opencontainers.image.licenses" = "GPL-3.0-only";
          };
          Env = [
            "HOME=/home/agent"
            "NIX_CONFIG=${nixConfig}"
            "SSL_CERT_FILE=${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt"
            # pi defaults to the kimi-for-coding subscription endpoint; the
            # key itself is injected by the attached kimi-for-coding
            # provider (models.json above reads it from $KIMI_API_KEY).
            "PI_PROVIDER=kimi-coding"
            "PI_MODEL=kimi-for-coding"
            # kimi-code: no models.dev catalog fetch on start (no catalog
            # egress under the sandbox policy — the provider/model is
            # baked in config.toml) and no telemetry.
            "KIMI_CODE_MODEL_CATALOG_REFRESH_ON_START=false"
            "KIMI_DISABLE_TELEMETRY=1"
            # claude-code: updater/telemetry/error-reporting/survey traffic
            # all targets hosts the policy does not admit; disabling keeps
            # the DENIED log to real API traffic. (The startup connectivity
            # preflight is NOT telemetry — platform.claude.com is admitted
            # in openshell/policies/code-agent.yaml for it and for
            # `claude auth login` token polling.)
            "DISABLE_AUTOUPDATER=1"
            "DISABLE_TELEMETRY=1"
            "DISABLE_ERROR_REPORTING=1"
            "DISABLE_BUG_COMMAND=1"
            "DISABLE_GROWTHBOOK=1"
            "DISABLE_FEEDBACK_SURVEY=1"
            # Foreign-glibc + manylinux-wheel runtime (see rootfs): the
            # nix-ld shim at /lib64/ld-linux-x86-64.so.2 reads NIX_LD /
            # NIX_LD_LIBRARY_PATH when a downloaded FHS binary execs, and
            # python wheel extensions resolve libstdc++/libgcc_s/libz from
            # the scoped wheel-deps dir. Deliberately narrow: a broader
            # LD_LIBRARY_PATH would shadow nix store RUNPATHs
            # process-wide (search order puts it before DT_RUNPATH).
            "LD_LIBRARY_PATH=/usr/lib/wheel-deps"
            "NIX_LD=${pkgs.glibc}/lib/ld-linux-x86-64.so.2"
            "NIX_LD_LIBRARY_PATH=${nixLdLibs}"
            # Terminfo db for plain-docker runs (under the supervisor the
            # same value comes from /etc/profile + ~/.bashrc + the
            # create-time --env set; see terminfoDb above).
            "TERMINFO_DIRS=/usr/share/terminfo:${pkgs.ncurses}/share/terminfo"
          ];
          Cmd = ["${pkgs.bashInteractive}/bin/bash" "-l"];
        };
      };
    };

    # The nix2container image is an image-spec JSON, not a loadable
    # tarball: copy it into the host docker store (where the VM driver
    # resolves images first) with skopeo. Registry pull is the fallback.
    apps.load-code-agent-image = {
      type = "app";
      program = toString (pkgs.writeShellScript "load-code-agent-image" ''
        set -euo pipefail
        exec ${inputs'.nix2container.packages.skopeo-nix2container}/bin/skopeo --insecure-policy \
          copy "nix:${self'.packages.code-agent-image}" docker-daemon:code-agent:latest
      '');
    };
  };
}
